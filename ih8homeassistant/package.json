{
    "name": "@ih8homeassistant/bridge",
    "version": "0.1.0",
    "description": "MQTT to Matter bridge using matter.js",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "start": "node --enable-source-maps dist/index.js",
        "dev": "tsc && node --enable-source-maps dist/index.js",
        "test": "tsc && node --test dist/tests/*.test.js",
        "clean": "rm -rf dist build"
    },
    "keywords": [
        "matter",
        "mqtt",
        "bridge",
        "smart-home",
        "iot"
    ],
    "author": "",
    "license": "Apache-2.0",
    "dependencies": {
        "@matter/main": "0.15.6",
        "@matter/nodejs": "0.15.6",
        "@modelcontextprotocol/node": "2.1.2",
        "@modelcontextprotocol/server": "2.4.0",
        "mqtt": "^5.14.1",
        "toml": "^3.0.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.4.0",
        "@types/node": "^20.0.0",
        "aedes": "1.2.0",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=20.19.0 <22.0.0 || >=22.13.0"
    }
}
